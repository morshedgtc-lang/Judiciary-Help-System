# Copy to .env and adjust for your environment.

# --- Application ---
PROJECT_NAME=Judiciary Help System
VERSION=0.1.0
DEBUG=true
API_V1_PREFIX=/api/v1

# --- Database ---
# SQLite for local dev; PostgreSQL in production, e.g.
#   postgresql+psycopg2://user:pass@host:5432/judiciary
DATABASE_URL=sqlite:///./judiciary_help.db
SQL_ECHO=false

# --- Security ---
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- CORS (comma-separated origins) ---
CORS_ORIGINS=*

# --- Judiciary scraper (causelist.judiciary.gov.bd) ---
JUDICIARY_BASE_URL=https://causelist.judiciary.gov.bd
JUDICIARY_MIN_INTERVAL=1.0
JUDICIARY_TIMEOUT=20

# --- Judiciary raw-HTTP cache (tiered: in-memory LRU + DB table) ---
# Master data (districts/courts/office units) cached 30 days, today's cause
# list 30 minutes, caseinfo pages 24 hours. On outage, stale copies are served.
JUDICIARY_HTTP_CACHE_ENABLED=true
JUDICIARY_HTTP_CACHE_CAPACITY=256
